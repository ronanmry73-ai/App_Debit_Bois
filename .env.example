# ID client OAuth « Application Web » (Google Cloud Console).
# Pas un secret — Vite l’injecte au *build* (Pages et npm run dev).
# Console : API Drive activée, origines JS = URL Pages + http://localhost:8080
# Scope : https://www.googleapis.com/auth/drive
# (drive.file seul ne peut pas modifier un JSON créé par le PC via H:\)
VITE_GOOGLE_CLIENT_ID=
